{
  "name": "@morning-brief/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --port 8787",
    "dev:remote": "wrangler dev --remote --port 8787",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "cf-typegen": "wrangler types",
    "pipeline:dry": "tsx scripts/generate.ts --dry-run",
    "pipeline:generate": "tsx scripts/generate.ts",
    "db:migrate": "wrangler d1 migrations apply morning-brief --local",
    "db:migrate:remote": "wrangler d1 migrations apply morning-brief --remote"
  },
  "dependencies": {
    "@morning-brief/shared": "*",
    "hono": "^4.12.32",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260101.0",
    "@types/node": "^26.1.2",
    "wrangler": "^4.114.0"
  }
}
