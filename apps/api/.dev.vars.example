# Copy to .dev.vars for local `wrangler dev`. Never commit the real file.

# Shared secret guarding POST /api/admin/edition. Generate with:
#   openssl rand -hex 32
CRON_SECRET=local-development-secret

# Origins allowed to call the API. Empty reflects the caller's origin, which is
# fine locally; set it explicitly in production.
ALLOWED_ORIGINS=http://localhost:3000

# Optional. Present = OpenAI becomes the summariser; absent = Workers AI.
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4.1-mini

# Optional override for the Workers AI model. The default is an 8B instruct
# model, chosen to stay inside the 10,000 neurons/day free allocation.
# WORKERS_AI_MODEL=@cf/meta/llama-3.1-8b-instruct
