{
  "name": "morning-brief",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm-run-all --parallel dev:api dev:web",
    "dev:api": "npm run dev --workspace @morning-brief/api",
    "dev:web": "npm run dev --workspace @morning-brief/web",
    "build": "npm run build --workspace @morning-brief/web",
    "test": "vitest run",
    "typecheck": "tsc -b --pretty",
    "pipeline:dry": "npm run pipeline:dry --workspace @morning-brief/api",
    "db:migrate": "npm run db:migrate --workspace @morning-brief/api",
    "db:migrate:remote": "npm run db:migrate:remote --workspace @morning-brief/api"
  },
  "devDependencies": {
    "npm-run-all": "^4.1.5",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=20"
  }
}
